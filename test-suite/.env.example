# Correctness harness configuration — copy to `.env` and fill in.
# `.env` is git-ignored (real credentials); this `.env.example` is committed as documentation.
# Loaded by conftest.py before test collection, so routes.py sees TARGET/base URLs at import.

# --- Which stack to test --------------------------------------------------
# php = legacy oracle (must be green before any migration exists)
# nextjs = a migrated Next.js cell
TARGET=php

# --- Base URLs of the running apps ----------------------------------------
PHP_BASE_URL=http://localhost:8080
NEXTJS_BASE_URL=http://localhost:3000

# --- Database (the seed is restored here before every test) ---------------
DB_HOST=host
DB_PORT=port
DB_USER=db_user
DB_PASSWORD=db_password
DB_NAME=silent_auction

# --- Seed file, path relative to the test-suite/ directory ----------------
SEED_PATH=../plan/phase1/data-model-documentation/seed.sql
