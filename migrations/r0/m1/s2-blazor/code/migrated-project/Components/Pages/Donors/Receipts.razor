@page "/donors/receipts"
@inject DonorService DonorService

<PageTitle>Tax Receipts | Taylor PTA - Silent Auction</PageTitle>

<DonorsSubNav ActiveTab="receipts" />

<FlashMessages />

<p class="c-page-intro">Select donors to generate tax receipts. Donors will be marked as receipt sent after generation.</p>

@if (_donors is null)
{
    <p>Loading...</p>
}
else if (_donors.Count == 0)
{
    <div class="c-empty-state">No donors eligible for tax receipts</div>
}
else
{
    <form method="post" action="/api/pdf/receipts">
        <div class="c-table-shell">
            <table class="c-table">
                <thead>
                    <tr>
                        <th>Select</th>
                        <th>ID</th>
                        <th>Business Name</th>
                        <th>Contact Name</th>
                        <th>Email</th>
                        <th>City</th>
                        <th>State</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var donor in _donors)
                    {
                        <tr>
                            <td><input type="checkbox" name="donorIds" value="@donor.DonorID" /></td>
                            <td>@donor.DonorID</td>
                            <td>@FormatHelper.OrDash(donor.BusinessName)</td>
                            <td>@FormatHelper.OrDash(donor.ContactName)</td>
                            <td>@FormatHelper.OrDash(donor.ContactEmail)</td>
                            <td>@FormatHelper.OrDash(donor.City)</td>
                            <td>@FormatHelper.OrDash(donor.State)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <button type="submit" class="c-button c-button--primary u-margin-top-space-200">Generate Tax Receipts</button>
    </form>
}

@code {
    private List<Donor>? _donors;

    protected override async Task OnInitializedAsync()
    {
        _donors = await DonorService.GetEligibleForReceiptAsync();
    }
}
