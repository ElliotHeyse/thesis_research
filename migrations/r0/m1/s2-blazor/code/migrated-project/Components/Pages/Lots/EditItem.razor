@page "/lots/items/edit"
@page "/lots/items/edit/{ItemId:int}"
@rendermode InteractiveServer
@inject ItemService ItemService
@inject DonorService DonorService
@inject NavigationManager Navigation

<PageTitle>@(IsEdit ? "Edit Item" : "Add Item") | Taylor PTA - Silent Auction</PageTitle>

<LotsSubNav ActiveTab="items" />

<FlashMessages />

<EditForm Model="_model" OnValidSubmit="HandleSubmit" class="c-form">
    <DataAnnotationsValidator />
    <ValidationSummary class="alert alert-danger" />

    <div class="c-form__field">
        <label for="description">Description</label>
        <InputText id="description" @bind-Value="_model.Description" maxlength="75" class="c-form__input" required />
        <ValidationMessage For="() => _model.Description" />
    </div>

    <div class="c-form__field">
        <label for="retailValue">Retail Value</label>
        <InputNumber id="retailValue" @bind-Value="_model.RetailValue" step="0.01" class="c-form__input" />
        <ValidationMessage For="() => _model.RetailValue" />
    </div>

    <div class="c-form__field">
        <label for="donorID">Donor</label>
        <InputSelect id="donorID" @bind-Value="_model.DonorID" class="c-form__input">
            <option value="0">— Select Donor —</option>
            @foreach (var donor in _donors)
            {
                <option value="@donor.DonorID">@donor.Label</option>
            }
        </InputSelect>
        <ValidationMessage For="() => _model.DonorID" />
    </div>

    <div class="c-form__field">
        <label for="lotID">Lot (optional)</label>
        <InputSelect id="lotID" @bind-Value="_lotSelection" class="c-form__input">
            <option value="">— Unassigned —</option>
            @foreach (var lot in _lots)
            {
                <option value="@lot.LotID">@lot.Description</option>
            }
        </InputSelect>
    </div>

    <div class="c-form__actions">
        <button type="submit" class="c-button c-button--primary">@(IsEdit ? "Update Item" : "Add Item")</button>
        <a href="/lots/items" class="c-button c-button--secondary">Cancel</a>
    </div>
</EditForm>

@code {
    [Parameter] public int? ItemId { get; set; }

    private ItemFormModel _model = new();
    private List<(int DonorID, string Label)> _donors = [];
    private List<(int LotID, string Description)> _lots = [];
    private string _lotSelection = string.Empty;
    private bool IsEdit => ItemId.HasValue;

    protected override async Task OnParametersSetAsync()
    {
        _donors = await DonorService.GetForSelectAsync();
        _lots = await ItemService.GetLotDescriptionsAsync();

        if (ItemId.HasValue)
        {
            var item = await ItemService.GetByIdAsync(ItemId.Value);
            if (item is null)
            {
                Navigation.NavigateTo("/lots/items?error=notfound");
                return;
            }
            _model = ItemFormModel.FromEntity(item);
            _lotSelection = item.LotID?.ToString() ?? string.Empty;
        }
        else
        {
            _model = new ItemFormModel();
            _lotSelection = string.Empty;
        }
    }

    private async Task HandleSubmit()
    {
        if (_model.DonorID <= 0)
        {
            return;
        }

        _model.LotID = int.TryParse(_lotSelection, out var lotId) ? lotId : null;

        var entity = new Item
        {
            ItemID = ItemId ?? 0,
            Description = _model.Description,
            RetailValue = _model.RetailValue,
            DonorID = _model.DonorID,
            LotID = _model.LotID
        };

        bool ok;
        if (IsEdit)
        {
            ok = await ItemService.UpdateAsync(entity);
            Navigation.NavigateTo(ok ? "/lots/items?success=updated" : "/lots/items?error=update_failed");
        }
        else
        {
            ok = await ItemService.AddAsync(entity);
            Navigation.NavigateTo(ok ? "/lots/items?success=created" : "/lots/items?error=create_failed");
        }
    }
}
