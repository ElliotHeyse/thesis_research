@page "/lots/items/delete/{ItemId:int}"
@rendermode InteractiveServer
@inject ItemService ItemService
@inject NavigationManager Navigation

<PageTitle>Delete Item | Taylor PTA - Silent Auction</PageTitle>

<LotsSubNav ActiveTab="items" />

@if (_item is null)
{
    <p>Loading...</p>
}
else
{
    <div class="c-confirm-delete">
        <h3>Delete Item</h3>
        <p>Are you sure you want to delete this item?</p>
        <dl class="c-confirm-delete__details">
            <dt>ID</dt><dd>@_item.ItemID</dd>
            <dt>Description</dt><dd>@_item.Description</dd>
            <dt>Retail Value</dt><dd>@FormatHelper.Currency(_item.RetailValue)</dd>
        </dl>
        <div class="c-form__actions">
            <button class="c-button c-button--danger" @onclick="ConfirmDelete">Confirm Delete</button>
            <a href="/lots/items" class="c-button c-button--secondary">Cancel</a>
        </div>
    </div>
}

@code {
    [Parameter] public int ItemId { get; set; }

    private Item? _item;

    protected override async Task OnParametersSetAsync()
    {
        _item = await ItemService.GetByIdAsync(ItemId);
        if (_item is null)
            Navigation.NavigateTo("/lots/items?error=notfound");
    }

    private async Task ConfirmDelete()
    {
        var ok = await ItemService.DeleteAsync(ItemId);
        Navigation.NavigateTo(ok ? "/lots/items?success=deleted" : "/lots/items?error=delete_failed");
    }
}
