@page "/lots/lots/delete/{LotId:int}"
@rendermode InteractiveServer
@inject LotService LotService
@inject NavigationManager Navigation

<PageTitle>Delete Lot | Taylor PTA - Silent Auction</PageTitle>

<LotsSubNav ActiveTab="lots" />

@if (_lot is null)
{
    <p>Loading...</p>
}
else
{
    <div class="c-confirm-delete">
        <h3>Delete Lot</h3>
        <p>Are you sure you want to delete this lot?</p>
        <dl class="c-confirm-delete__details">
            <dt>ID</dt><dd>@_lot.LotID</dd>
            <dt>Description</dt><dd>@_lot.Description</dd>
        </dl>
        <div class="c-form__actions">
            <button class="c-button c-button--danger" @onclick="ConfirmDelete">Confirm Delete</button>
            <a href="/lots/lots" class="c-button c-button--secondary">Cancel</a>
        </div>
    </div>
}

@code {
    [Parameter] public int LotId { get; set; }

    private Lot? _lot;

    protected override async Task OnParametersSetAsync()
    {
        _lot = await LotService.GetByIdAsync(LotId);
        if (_lot is null)
            Navigation.NavigateTo("/lots/lots?error=notfound");
    }

    private async Task ConfirmDelete()
    {
        await LotService.DeleteAsync(LotId);
        Navigation.NavigateTo("/lots/lots?success=deleted");
    }
}
