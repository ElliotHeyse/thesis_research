@page "/donors/delete/{DonorId:int}"
@rendermode InteractiveServer
@inject DonorService DonorService
@inject NavigationManager Navigation

<PageTitle>Delete Donor | Taylor PTA - Silent Auction</PageTitle>

<DonorsSubNav ActiveTab="donors" />

@if (_donor is null)
{
    <p>Loading...</p>
}
else
{
    <div class="c-confirm-delete">
        <h3>Delete Donor</h3>
        <p>Are you sure you want to delete this donor?</p>
        <dl class="c-confirm-delete__details">
            <dt>ID</dt><dd>@_donor.DonorID</dd>
            <dt>Business Name</dt><dd>@FormatHelper.OrDash(_donor.BusinessName)</dd>
            <dt>Contact Name</dt><dd>@_donor.ContactName</dd>
            <dt>Email</dt><dd>@FormatHelper.OrDash(_donor.ContactEmail)</dd>
        </dl>
        <div class="c-form__actions">
            <button class="c-button c-button--danger" @onclick="ConfirmDelete">Confirm Delete</button>
            <a href="/donors" class="c-button c-button--secondary">Cancel</a>
        </div>
    </div>
}

@code {
    [Parameter] public int DonorId { get; set; }

    private Donor? _donor;

    protected override async Task OnParametersSetAsync()
    {
        _donor = await DonorService.GetByIdAsync(DonorId);
        if (_donor is null)
            Navigation.NavigateTo("/donors?error=notfound");
    }

    private async Task ConfirmDelete()
    {
        var ok = await DonorService.DeleteAsync(DonorId);
        Navigation.NavigateTo(ok ? "/donors?success=deleted" : "/donors?error=has_items");
    }
}
