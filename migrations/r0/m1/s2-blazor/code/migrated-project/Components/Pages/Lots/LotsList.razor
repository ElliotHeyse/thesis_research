@page "/lots/lots"
@inject LotService LotService

<PageTitle>Lots | Taylor PTA - Silent Auction</PageTitle>

<LotsSubNav ActiveTab="lots">
    <ActionContent>
        <a href="/lots/lots/edit" class="c-button c-button--primary">Add New Lot</a>
    </ActionContent>
</LotsSubNav>

<FlashMessages />

@if (_lots is null)
{
    <p>Loading...</p>
}
else if (_lots.Count == 0)
{
    <div class="c-empty-state">No lots found</div>
}
else
{
    <div class="c-table-shell">
        <table class="c-table">
            <thead>
                <tr>
                    <th>Lot ID</th>
                    <th>Description</th>
                    <th>Highest Bid</th>
                    <th>Winner</th>
                    <th>Delivered</th>
                    <th>Category</th>
                    <th>Edit Lot</th>
                    <th>View Lot</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var lot in _lots)
                {
                    <tr>
                        <td>@lot.LotID</td>
                        <td>@FormatHelper.OrDash(lot.Description)</td>
                        <td>@FormatHelper.Currency(lot.WinningBid)</td>
                        <td>@FormatHelper.OrDash(lot.Winner)</td>
                        <td>@FormatHelper.YesNo(lot.Delivered)</td>
                        <td>@FormatHelper.OrDash(lot.Category)</td>
                        <td><a href="/lots/lots/edit/@lot.LotID">Edit</a></td>
                        <td><a href="/lots/lots/@lot.LotID">View</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<LotListRow>? _lots;

    protected override async Task OnInitializedAsync()
    {
        _lots = await LotService.GetAllAsync();
    }
}
