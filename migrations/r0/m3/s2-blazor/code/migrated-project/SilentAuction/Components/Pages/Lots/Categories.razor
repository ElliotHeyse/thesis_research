@page "/lots/categories"
@rendermode InteractiveServer
@inject CategoryService CategoryService

<PageTitle>Categories | Taylor PTA - Silent Auction</PageTitle>

<LotsSubnav>
    <ActionContent>
        <a href="/lots/categories/edit" class="c-btn c-btn--primary">Add New Category</a>
    </ActionContent>
</LotsSubnav>
<FlashAlert />

@if (_categories is null)
{
    <p>Loading...</p>
}
else if (_categories.Count == 0)
{
    <p class="c-empty-state">No categories found.</p>
}
else
{
    <div class="c-table-shell">
        <table class="c-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Description</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var category in _categories)
                {
                    <tr>
                        <td>@category.CategoryID</td>
                        <td>@category.Description</td>
                        <td class="c-table__actions">
                            <a href="/lots/categories/edit/@category.CategoryID">Edit</a>
                            <a href="/lots/categories/delete/@category.CategoryID">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<Data.Entities.Category>? _categories;

    protected override async Task OnInitializedAsync() =>
        _categories = await CategoryService.GetAllAsync();
}
