@inject NavigationManager Navigation

<Subnav Tabs="Tabs" ActiveKey="@ActiveKey" ActionContent="@ActionContent" />

@code {
    [Parameter] public RenderFragment? ActionContent { get; set; }

    private static readonly IReadOnlyList<Subnav.SubnavTab> Tabs =
    [
        new("donors", "All Donors", "/donors"),
        new("pending", "Pending Receipts", "/donors/pending-receipts"),
        new("letters", "Letters", "/donors/letters"),
        new("receipts", "Tax Receipts", "/donors/receipts")
    ];

    private string ActiveKey
    {
        get
        {
            var path = Navigation.ToBaseRelativePath(Navigation.Uri).Split('?')[0];
            if (path.StartsWith("donors/pending-receipts")) return "pending";
            if (path.StartsWith("donors/letters")) return "letters";
            if (path.StartsWith("donors/receipts")) return "receipts";
            return "donors";
        }
    }
}
