@page "/lots/categories/edit"
@page "/lots/categories/edit/{CategoryId:int}"
@rendermode InteractiveServer
@inject CategoryService CategoryService
@inject NavigationManager Navigation
@using SilentAuction.Models
@using SilentAuction.Validation

<PageTitle>@(CategoryId.HasValue ? "Edit Category" : "Add Category") | Taylor PTA - Silent Auction</PageTitle>

<LotsSubnav>
    <ActionContent>
        @if (CategoryId.HasValue)
        {
            <a href="/lots/categories/delete/@CategoryId" class="c-btn c-btn--danger">Delete Category</a>
        }
    </ActionContent>
</LotsSubnav>
<FlashAlert />

<EditForm Model="_model" OnValidSubmit="HandleSubmit" class="c-form">
    <div class="c-form__field">
        <label for="description">Description *</label>
        <InputText id="description" @bind-Value="_model.Description" maxlength="75" class="c-input" required />
        @if (_errors.TryGetValue(nameof(_model.Description), out var d)) { <span class="c-form__error">@d</span> }
    </div>
    <div class="c-form__actions">
        <button type="submit" class="c-btn c-btn--primary">@(CategoryId.HasValue ? "Update Category" : "Add Category")</button>
        <a href="/lots/categories" class="c-btn c-btn--secondary">Cancel</a>
    </div>
</EditForm>

@code {
    [Parameter] public int? CategoryId { get; set; }

    private CategoryFormModel _model = new();
    private Dictionary<string, string> _errors = new();

    protected override async Task OnParametersSetAsync()
    {
        if (CategoryId.HasValue)
        {
            var category = await CategoryService.GetByIdAsync(CategoryId.Value);
            if (category is null)
            {
                Navigation.NavigateTo("/lots/categories?error=notfound");
                return;
            }
            _model = new CategoryFormModel { Description = category.Description };
        }
    }

    private async Task HandleSubmit()
    {
        _errors = CategoryValidator.Validate(_model);
        if (_errors.Count > 0) return;

        var result = CategoryId.HasValue
            ? await CategoryService.UpdateAsync(CategoryId.Value, _model)
            : await CategoryService.CreateAsync(_model);

        var type = result.IsSuccess ? "success" : "error";
        Navigation.NavigateTo($"/lots/categories?{type}={result.FlashCode}");
    }
}
