@page "/lots/lots"
@rendermode InteractiveServer
@inject LotService LotService
@using SilentAuction.Models
@using SilentAuction.Services

<PageTitle>Lots | Taylor PTA - Silent Auction</PageTitle>

<LotsSubnav>
    <ActionContent>
        <a href="/lots/lots/edit" class="c-btn c-btn--primary">Add New Lot</a>
    </ActionContent>
</LotsSubnav>
<FlashAlert />

@if (_lots is null)
{
    <p>Loading...</p>
}
else if (_lots.Count == 0)
{
    <p class="c-empty-state">No lots found.</p>
}
else
{
    <div class="c-table-shell">
        <table class="c-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Description</th>
                    <th>Highest Bid</th>
                    <th>Winner</th>
                    <th>Delivered</th>
                    <th>Category</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var lot in _lots)
                {
                    <tr>
                        <td>@lot.LotID</td>
                        <td>@lot.Description</td>
                        <td>@FormatService.FormatCurrency(lot.WinningBid)</td>
                        <td>@FormatService.FormatOrDash(lot.Winner)</td>
                        <td>@FormatService.FormatYesNo(lot.Delivered)</td>
                        <td>@FormatService.FormatOrDash(lot.Category)</td>
                        <td class="c-table__actions">
                            <a href="/lots/lots/@lot.LotID">View</a>
                            <a href="/lots/lots/edit/@lot.LotID">Edit</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<LotListDto>? _lots;

    protected override async Task OnInitializedAsync() =>
        _lots = await LotService.GetAllAsync();
}
