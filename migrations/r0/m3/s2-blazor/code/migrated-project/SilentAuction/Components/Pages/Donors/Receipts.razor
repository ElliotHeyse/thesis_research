@page "/donors/receipts"
@rendermode InteractiveServer
@inject DonorService DonorService
@using SilentAuction.Data.Entities
@using SilentAuction.Services

<PageTitle>Tax Receipts | Taylor PTA - Silent Auction</PageTitle>

<DonorsSubnav />
<FlashAlert />

@if (_donors is null)
{
    <p>Loading...</p>
}
else if (_donors.Count == 0)
{
    <p class="c-empty-state">No eligible donors for tax receipts.</p>
}
else
{
    <form method="post" action="/api/pdf/tax-receipts">
        <div class="c-table-shell">
            <table class="c-table">
                <thead>
                    <tr>
                        <th>Select</th>
                        <th>Donor</th>
                        <th>Contact</th>
                        <th>City</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var donor in _donors)
                    {
                        <tr>
                            <td><input type="checkbox" name="donorIds" value="@donor.DonorID" /></td>
                            <td>@FormatService.GetDonorDisplayName(donor)</td>
                            <td>@donor.ContactName</td>
                            <td>@FormatService.FormatOrDash(donor.City)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="c-form__actions u-margin-top-space-200">
            <button type="submit" class="c-btn c-btn--primary">Generate Tax Receipts PDF</button>
        </div>
    </form>
}

@code {
    private List<Donor>? _donors;

    protected override async Task OnInitializedAsync() =>
        _donors = await DonorService.GetEligibleForReceiptAsync();
}
