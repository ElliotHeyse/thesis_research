@page "/lots/lots/delete/{LotId:int}"
@rendermode InteractiveServer
@inject LotService LotService
@inject NavigationManager Navigation

<PageTitle>Delete Lot | Taylor PTA - Silent Auction</PageTitle>

<LotsSubnav />

@if (_lot is null)
{
    <p>Loading...</p>
}
else
{
    <ConfirmDelete Title="Delete Lot"
                   Message="@($"Are you sure you want to delete lot \"{_lot.Description}\"?")"
                   CancelHref="/lots/lots"
                   OnConfirm="ConfirmDelete" />
}

@code {
    [Parameter] public int LotId { get; set; }

    private Models.LotDetailDto? _lot;

    protected override async Task OnParametersSetAsync()
    {
        _lot = await LotService.GetByIdAsync(LotId);
        if (_lot is null)
            Navigation.NavigateTo("/lots/lots?error=notfound");
    }

    private async Task ConfirmDelete()
    {
        var result = await LotService.DeleteAsync(LotId);
        var type = result.IsSuccess ? "success" : "error";
        Navigation.NavigateTo($"/lots/lots?{type}={result.FlashCode}");
    }
}
