@page "/donors/edit"
@page "/donors/edit/{DonorId:int}"
@rendermode InteractiveServer
@inject DonorService DonorService
@inject NavigationManager Navigation
@using SilentAuction.Models
@using SilentAuction.Validation

<PageTitle>@(DonorId.HasValue ? "Edit Donor" : "Add Donor") | Taylor PTA - Silent Auction</PageTitle>

<DonorsSubnav />
<FlashAlert />

<EditForm Model="_model" OnValidSubmit="HandleSubmit" class="c-form">
    <div class="c-form__field">
        <label for="businessName">Business Name</label>
        <InputText id="businessName" @bind-Value="_model.BusinessName" maxlength="75" class="c-input" />
        @if (_errors.TryGetValue(nameof(_model.BusinessName), out var bn)) { <span class="c-form__error">@bn</span> }
    </div>
    <div class="c-form__field">
        <label for="contactName">Contact Name *</label>
        <InputText id="contactName" @bind-Value="_model.ContactName" maxlength="75" class="c-input" required />
        @if (_errors.TryGetValue(nameof(_model.ContactName), out var cn)) { <span class="c-form__error">@cn</span> }
    </div>
    <div class="c-form__field">
        <label for="contactEmail">Email</label>
        <InputText id="contactEmail" @bind-Value="_model.ContactEmail" maxlength="200" class="c-input" />
        @if (_errors.TryGetValue(nameof(_model.ContactEmail), out var ce)) { <span class="c-form__error">@ce</span> }
    </div>
    <div class="c-form__field">
        <label for="contactTitle">Contact Title</label>
        <InputText id="contactTitle" @bind-Value="_model.ContactTitle" maxlength="75" class="c-input" />
        @if (_errors.TryGetValue(nameof(_model.ContactTitle), out var ct)) { <span class="c-form__error">@ct</span> }
    </div>
    <div class="c-form__field">
        <label for="address">Address</label>
        <InputText id="address" @bind-Value="_model.Address" maxlength="75" class="c-input" />
        @if (_errors.TryGetValue(nameof(_model.Address), out var ad)) { <span class="c-form__error">@ad</span> }
    </div>
    <div class="c-form__field">
        <label for="city">City</label>
        <InputText id="city" @bind-Value="_model.City" maxlength="30" class="c-input" />
        @if (_errors.TryGetValue(nameof(_model.City), out var ci)) { <span class="c-form__error">@ci</span> }
    </div>
    <div class="c-form__field">
        <label for="state">State</label>
        <InputText id="state" @bind-Value="_model.State" maxlength="2" class="c-input" />
        @if (_errors.TryGetValue(nameof(_model.State), out var st)) { <span class="c-form__error">@st</span> }
    </div>
    <div class="c-form__field">
        <label for="zipCode">Zip Code</label>
        <InputText id="zipCode" @bind-Value="_model.ZipCode" maxlength="5" class="c-input" />
        @if (_errors.TryGetValue(nameof(_model.ZipCode), out var zc)) { <span class="c-form__error">@zc</span> }
    </div>
    @if (DonorId.HasValue)
    {
        <div class="c-form__field">
            <label><InputCheckbox @bind-Value="_model.TaxReceipt" /> Tax Receipt Sent</label>
        </div>
    }
    <div class="c-form__actions">
        <button type="submit" class="c-btn c-btn--primary">@(DonorId.HasValue ? "Update Donor" : "Add Donor")</button>
        <a href="/donors" class="c-btn c-btn--secondary">Cancel</a>
    </div>
</EditForm>

@code {
    [Parameter] public int? DonorId { get; set; }

    private DonorFormModel _model = new();
    private Dictionary<string, string> _errors = new();

    protected override async Task OnParametersSetAsync()
    {
        if (DonorId.HasValue)
        {
            var donor = await DonorService.GetByIdAsync(DonorId.Value);
            if (donor is null)
            {
                Navigation.NavigateTo("/donors?error=notfound");
                return;
            }
            _model = new DonorFormModel
            {
                BusinessName = donor.BusinessName,
                ContactName = donor.ContactName,
                ContactEmail = donor.ContactEmail,
                ContactTitle = donor.ContactTitle,
                Address = donor.Address,
                City = donor.City,
                State = donor.State,
                ZipCode = donor.ZipCode,
                TaxReceipt = donor.TaxReceipt
            };
        }
    }

    private async Task HandleSubmit()
    {
        _errors = DonorValidator.Validate(_model);
        if (_errors.Count > 0) return;

        var result = DonorId.HasValue
            ? await DonorService.UpdateAsync(DonorId.Value, _model)
            : await DonorService.CreateAsync(_model);

        if (result.Status == OperationStatus.ValidationError)
        {
            _errors = DonorValidator.Validate(_model);
            return;
        }

        var type = result.IsSuccess ? "success" : "error";
        Navigation.NavigateTo($"/donors?{type}={result.FlashCode}");
    }
}
