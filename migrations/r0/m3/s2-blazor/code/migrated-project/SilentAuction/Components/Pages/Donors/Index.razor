@page "/donors"
@rendermode InteractiveServer
@inject DonorService DonorService
@using SilentAuction.Data.Entities
@using SilentAuction.Services

<PageTitle>Donors | Taylor PTA - Silent Auction</PageTitle>

<DonorsSubnav>
    <ActionContent>
        <a href="/donors/edit" class="c-btn c-btn--primary">Add New Donor</a>
    </ActionContent>
</DonorsSubnav>
<FlashAlert />

@if (_donors is null)
{
    <p>Loading...</p>
}
else if (_donors.Count == 0)
{
    <p class="c-empty-state">No donors found.</p>
}
else
{
    <div class="c-table-shell">
        <table class="c-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Business</th>
                    <th>Contact</th>
                    <th>Email</th>
                    <th>City</th>
                    <th>State</th>
                    <th>Tax Receipt</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var donor in _donors)
                {
                    <tr>
                        <td>@donor.DonorID</td>
                        <td>@FormatService.FormatOrDash(donor.BusinessName)</td>
                        <td>@donor.ContactName</td>
                        <td>@FormatService.FormatOrDash(donor.ContactEmail)</td>
                        <td>@FormatService.FormatOrDash(donor.City)</td>
                        <td>@FormatService.FormatOrDash(donor.State)</td>
                        <td>@FormatService.FormatYesNo(donor.TaxReceipt)</td>
                        <td class="c-table__actions">
                            <a href="/donors/edit/@donor.DonorID">Edit</a>
                            <a href="/donors/delete/@donor.DonorID">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<Donor>? _donors;

    protected override async Task OnInitializedAsync() =>
        _donors = await DonorService.GetAllAsync();
}
