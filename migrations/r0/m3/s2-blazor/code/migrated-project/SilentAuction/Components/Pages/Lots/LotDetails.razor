@page "/lots/lots/{LotId:int}"
@rendermode InteractiveServer
@inject LotService LotService
@inject NavigationManager Navigation
@using SilentAuction.Services

<PageTitle>Lot Details | Taylor PTA - Silent Auction</PageTitle>

<LotsSubnav />

@if (_lot is null)
{
    <p>Loading...</p>
}
else
{
    <div class="o-flex o-flex--column u-gap-space-200">
        <h2>Lot #@_lot.LotID</h2>
        @if (!string.IsNullOrEmpty(_lot.Image))
        {
            <img src="@_lot.Image" alt="Lot image" style="max-width: 300px;" />
        }
        <div class="c-detail">
            <div><strong>Description:</strong> @_lot.Description</div>
            <div><strong>Category:</strong> @FormatService.FormatOrDash(_lot.CategoryDescription)</div>
            <div><strong>Highest Bid:</strong> @FormatService.FormatCurrency(_lot.WinningBid)</div>
            <div><strong>Winner:</strong> @FormatService.FormatOrDash(_lot.WinnerName ?? "No winner yet")</div>
            <div><strong>Delivered:</strong> @FormatService.FormatYesNo(_lot.Delivered)</div>
        </div>
        <div>
            <a href="/lots/lots/edit/@_lot.LotID" class="c-btn c-btn--primary">Edit Lot</a>
            <a href="/lots/lots" class="c-btn c-btn--secondary">Back to Lots</a>
        </div>
    </div>
}

@code {
    [Parameter] public int LotId { get; set; }

    private Models.LotDetailDto? _lot;

    protected override async Task OnParametersSetAsync()
    {
        _lot = await LotService.GetByIdAsync(LotId);
        if (_lot is null)
            Navigation.NavigateTo("/lots/lots?error=notfound");
    }
}
