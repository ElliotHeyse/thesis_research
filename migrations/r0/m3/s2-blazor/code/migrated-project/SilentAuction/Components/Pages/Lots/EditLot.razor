@page "/lots/lots/edit"
@page "/lots/lots/edit/{LotId:int}"
@rendermode InteractiveServer
@inject LotService LotService
@inject CategoryService CategoryService
@inject NavigationManager Navigation
@using SilentAuction.Models
@using SilentAuction.Validation

<PageTitle>@(LotId.HasValue ? "Edit Lot" : "Add Lot") | Taylor PTA - Silent Auction</PageTitle>

<LotsSubnav>
    <ActionContent>
        @if (LotId.HasValue)
        {
            <a href="/lots/lots/delete/@LotId" class="c-btn c-btn--danger">Delete Lot</a>
        }
    </ActionContent>
</LotsSubnav>
<FlashAlert />

@if (_categories is null || _bidders is null)
{
    <p>Loading...</p>
}
else
{
    <EditForm Model="_model" OnValidSubmit="HandleSubmit" class="c-form">
        <div class="c-form__field">
            <label for="description">Description *</label>
            <InputText id="description" @bind-Value="_model.Description" maxlength="75" class="c-input" required />
            @if (_errors.TryGetValue(nameof(_model.Description), out var d)) { <span class="c-form__error">@d</span> }
        </div>
        <div class="c-form__field">
            <label for="categoryId">Category</label>
            <InputSelect id="categoryId" @bind-Value="_categorySelect" class="c-input">
                <option value="">No category</option>
                @foreach (var cat in _categories)
                {
                    <option value="@cat.CategoryID">@cat.Description</option>
                }
            </InputSelect>
        </div>
        <div class="c-form__field">
            <label for="winningBid">Highest Bid</label>
            <InputNumber id="winningBid" @bind-Value="_model.WinningBid" class="c-input" />
        </div>
        <div class="c-form__field">
            <label for="winningBidder">Winning Bidder</label>
            <InputSelect id="winningBidder" @bind-Value="_bidderSelect" class="c-input">
                <option value="">No winner</option>
                @foreach (var bidder in _bidders)
                {
                    <option value="@bidder.BidderID">@bidder.Name</option>
                }
            </InputSelect>
        </div>
        <div class="c-form__field">
            <label><InputCheckbox @bind-Value="_model.Delivered" /> Delivered</label>
        </div>
        <div class="c-form__field">
            <label for="image">Image URL</label>
            <InputText id="image" @bind-Value="_model.Image" class="c-input" />
            @if (_errors.TryGetValue(nameof(_model.Image), out var img)) { <span class="c-form__error">@img</span> }
        </div>
        <div class="c-form__actions">
            <button type="submit" class="c-btn c-btn--primary">@(LotId.HasValue ? "Update Lot" : "Add Lot")</button>
            <a href="/lots/lots" class="c-btn c-btn--secondary">Cancel</a>
        </div>
    </EditForm>
}

@code {
    [Parameter] public int? LotId { get; set; }

    private LotFormModel _model = new();
    private List<Data.Entities.Category>? _categories;
    private List<BidderOptionDto>? _bidders;
    private Dictionary<string, string> _errors = new();
    private string _categorySelect = "";
    private string _bidderSelect = "";

    protected override async Task OnParametersSetAsync()
    {
        _categories = await CategoryService.GetAllAsync();
        _bidders = await LotService.GetBiddersAsync();

        if (LotId.HasValue)
        {
            var lot = await LotService.GetByIdAsync(LotId.Value);
            if (lot is null)
            {
                Navigation.NavigateTo("/lots/lots?error=notfound");
                return;
            }
            _model = new LotFormModel
            {
                Description = lot.Description,
                CategoryID = lot.CategoryID,
                WinningBid = lot.WinningBid,
                WinningBidder = lot.WinningBidder,
                Delivered = lot.Delivered,
                Image = lot.Image
            };
            _categorySelect = lot.CategoryID?.ToString() ?? "";
            _bidderSelect = lot.WinningBidder?.ToString() ?? "";
        }
    }

    private async Task HandleSubmit()
    {
        _model.CategoryID = int.TryParse(_categorySelect, out var catId) ? catId : null;
        _model.WinningBidder = int.TryParse(_bidderSelect, out var bidId) ? bidId : null;

        _errors = LotValidator.Validate(_model);
        if (_errors.Count > 0) return;

        var result = LotId.HasValue
            ? await LotService.UpdateAsync(LotId.Value, _model)
            : await LotService.CreateAsync(_model);

        var type = result.IsSuccess ? "success" : "error";
        Navigation.NavigateTo($"/lots/lots?{type}={result.FlashCode}");
    }
}
