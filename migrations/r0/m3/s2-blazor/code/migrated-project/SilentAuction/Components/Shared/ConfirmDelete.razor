<div class="c-confirm-delete">
    <h2>@Title</h2>
    <p>@Message</p>
    @if (CanDelete)
    {
        <div class="o-flex u-gap-space-100">
            <button type="button" class="c-btn c-btn--danger" @onclick="OnConfirm">@ConfirmLabel</button>
            <a href="@CancelHref" class="c-btn c-btn--secondary">Cancel</a>
        </div>
    }
    else
    {
        <a href="@CancelHref" class="c-btn c-btn--secondary">Back</a>
    }
</div>

@code {
    [Parameter] public string Title { get; set; } = "Confirm Delete";
    [Parameter] public string Message { get; set; } = "Are you sure you want to delete this record?";
    [Parameter] public string ConfirmLabel { get; set; } = "Delete";
    [Parameter] public string CancelHref { get; set; } = "/";
    [Parameter] public bool CanDelete { get; set; } = true;
    [Parameter] public EventCallback OnConfirm { get; set; }
}
