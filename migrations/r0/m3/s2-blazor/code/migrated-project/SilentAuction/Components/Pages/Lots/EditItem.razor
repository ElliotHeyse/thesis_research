@page "/lots/items/edit"
@page "/lots/items/edit/{ItemId:int}"
@rendermode InteractiveServer
@inject ItemService ItemService
@inject NavigationManager Navigation
@using SilentAuction.Models
@using SilentAuction.Validation

<PageTitle>@(ItemId.HasValue ? "Edit Item" : "Add Item") | Taylor PTA - Silent Auction</PageTitle>

<LotsSubnav />
<FlashAlert />

@if (_donors is null || _lots is null)
{
    <p>Loading...</p>
}
else
{
    <EditForm Model="_model" OnValidSubmit="HandleSubmit" class="c-form">
        <div class="c-form__field">
            <label for="description">Description *</label>
            <InputText id="description" @bind-Value="_model.Description" maxlength="75" class="c-input" required />
            @if (_errors.TryGetValue(nameof(_model.Description), out var d)) { <span class="c-form__error">@d</span> }
        </div>
        <div class="c-form__field">
            <label for="retailValue">Retail Value</label>
            <InputNumber id="retailValue" @bind-Value="_model.RetailValue" class="c-input" />
        </div>
        <div class="c-form__field">
            <label for="donorId">Donor *</label>
            <InputSelect id="donorId" @bind-Value="_model.DonorID" class="c-input">
                <option value="0">Select donor...</option>
                @foreach (var donor in _donors)
                {
                    <option value="@donor.DonorID">@(string.IsNullOrWhiteSpace(donor.BusinessName) ? donor.ContactName : $"{donor.BusinessName} ({donor.ContactName})")</option>
                }
            </InputSelect>
            @if (_errors.TryGetValue(nameof(_model.DonorID), out var di)) { <span class="c-form__error">@di</span> }
        </div>
        <div class="c-form__field">
            <label for="lotId">Lot</label>
            <InputSelect id="lotId" @bind-Value="_lotSelect" class="c-input">
                <option value="-1">No lot selected</option>
                @foreach (var lot in _lots)
                {
                    <option value="@lot.LotID">@lot.Description</option>
                }
            </InputSelect>
        </div>
        <div class="c-form__actions">
            <button type="submit" class="c-btn c-btn--primary">@(ItemId.HasValue ? "Update Item" : "Add Item")</button>
            <a href="/lots/items" class="c-btn c-btn--secondary">Cancel</a>
        </div>
    </EditForm>
}

@code {
    [Parameter] public int? ItemId { get; set; }

    private ItemFormModel _model = new();
    private List<DonorSelectDto>? _donors;
    private List<LotOptionDto>? _lots;
    private Dictionary<string, string> _errors = new();
    private int _lotSelect = -1;

    protected override async Task OnParametersSetAsync()
    {
        _donors = await ItemService.GetDonorOptionsAsync();
        _lots = await ItemService.GetLotOptionsAsync();

        if (ItemId.HasValue)
        {
            var item = await ItemService.GetByIdAsync(ItemId.Value);
            if (item is null)
            {
                Navigation.NavigateTo("/lots/items?error=notfound");
                return;
            }
            _model = new ItemFormModel
            {
                Description = item.Description,
                RetailValue = item.RetailValue,
                DonorID = item.DonorID,
                LotID = item.LotID
            };
            _lotSelect = item.LotID ?? -1;
        }
    }

    private async Task HandleSubmit()
    {
        _model.LotID = _lotSelect <= 0 ? null : _lotSelect;
        _errors = ItemValidator.Validate(_model);
        if (_errors.Count > 0) return;

        var result = ItemId.HasValue
            ? await ItemService.UpdateAsync(ItemId.Value, _model)
            : await ItemService.CreateAsync(_model);

        var type = result.IsSuccess ? "success" : "error";
        Navigation.NavigateTo($"/lots/items?{type}={result.FlashCode}");
    }
}
