<div class="confirm-container">
    <h2 class="confirm-title">Confirm Deletion</h2>
    <p style="text-align: center; margin-bottom: 30px;">
        <strong>Are you sure you want to delete this @EntityType?</strong><br>
        This action cannot be undone.
    </p>
    <div class="entity-details">
        @Fields
    </div>
    <div class="button-group">
        <a href="@ConfirmUrl" class="c-btn c-btn--danger">Yes, Delete Permanently</a>
        <a href="@CancelUrl" class="c-btn c-btn--secondary">No, Cancel</a>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public string EntityType { get; set; } = string.Empty;
    [Parameter, EditorRequired] public RenderFragment Fields { get; set; } = null!;
    [Parameter, EditorRequired] public string ConfirmUrl { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string CancelUrl { get; set; } = string.Empty;
}
