@page "/lots/items/delete/{ItemId:int}"
@page "/lots/items/delete/{ItemId:int}/confirm"
@rendermode InteractiveServer
@inject ItemService ItemService
@inject NavigationManager Navigation
@inject FlashMessageService Flash

<PageTitle>Delete Item | Taylor PTA - Silent Auction</PageTitle>

<LotsSubNav />

@if (_item is null)
{
    <p>Loading...</p>
}
else if (!_confirmed)
{
    <ConfirmDelete EntityType="item"
                   ConfirmUrl="@($"/lots/items/delete/{ItemId}/confirm")"
                   CancelUrl="/lots/items">
        <Fields>
            <p><strong>Item ID:</strong> @_item.ItemID</p>
            <p><strong>Description:</strong> @FormatHelper.OrDash(_item.Description)</p>
            <p><strong>Retail Value:</strong> @FormatHelper.Currency(_item.RetailValue)</p>
            <p><strong>Donor ID:</strong> @_item.DonorID</p>
        </Fields>
    </ConfirmDelete>
}

@code {
    [Parameter] public int ItemId { get; set; }

    private ItemDetailRow? _item;
    private bool _confirmed;

    protected override async Task OnParametersSetAsync()
    {
        _item = await ItemService.GetItemByIdAsync(ItemId);
        if (_item is null)
        {
            Flash.SetError("notfound");
            Navigation.NavigateTo("/lots/items");
            return;
        }

        if (Navigation.Uri.Contains("/confirm", StringComparison.OrdinalIgnoreCase))
        {
            _confirmed = true;
            var ok = await ItemService.DeleteItemAsync(ItemId);
            Flash.SetSuccess(ok ? "deleted" : "delete_failed");
            Navigation.NavigateTo("/lots/items");
        }
    }
}
