@page "/lots/lots/edit"
@page "/lots/lots/edit/{LotId:int}"
@rendermode InteractiveServer
@inject LotService LotService
@inject CategoryService CategoryService
@inject NavigationManager Navigation
@inject FlashMessageService Flash

<PageTitle>@(LotId.HasValue ? "Edit Lot" : "Add Lot") | Taylor PTA - Silent Auction</PageTitle>

<LotsSubNav ActionContent="@_deleteButton" />
<FlashAlert />

<EditForm Model="_model" OnValidSubmit="HandleSubmit" class="c-form">
    <DataAnnotationsValidator />

    <div class="c-form__field">
        <label for="Description">Description</label>
        <InputText id="Description" @bind-Value="_model.Description" class="c-form__input" />
        <ValidationMessage For="@(() => _model.Description)" />
    </div>

    <div class="c-form__field">
        <label for="CategoryID">Category</label>
        <InputSelect id="CategoryID" @bind-Value="_model.CategoryID" class="c-form__input">
            <option value="">Select category</option>
            @foreach (var category in _categories)
            {
                <option value="@category.CategoryID">@category.Description</option>
            }
        </InputSelect>
    </div>

    <div class="c-form__field">
        <label for="HighestBid">Highest Bid</label>
        <InputNumber id="HighestBid" @bind-Value="_model.HighestBid" class="c-form__input" step="0.01" />
        <ValidationMessage For="@(() => _model.HighestBid)" />
    </div>

    <div class="c-form__field">
        <label for="BidderID">Bidder</label>
        <InputSelect id="BidderID" @bind-Value="_model.BidderID" class="c-form__input">
            <option value="">Select bidder</option>
            @foreach (var bidder in _bidders)
            {
                <option value="@bidder.BidderID">@bidder.Name</option>
            }
        </InputSelect>
    </div>

    <div class="c-form__field">
        <label>
            <InputCheckbox @bind-Value="_model.Delivered" />
            Delivered
        </label>
    </div>

    <div class="c-form__field">
        <label for="Image">Image URL</label>
        <InputText id="Image" @bind-Value="_model.Image" class="c-form__input" />
        <ValidationMessage For="@(() => _model.Image)" />
    </div>

    <div class="form-actions">
        <button type="submit" class="c-btn c-btn--primary">@(LotId.HasValue ? "Update" : "Add Lot")</button>
        <a href="/lots/lots" class="c-btn c-btn--secondary">Cancel</a>
    </div>
</EditForm>

@code {
    [Parameter] public int? LotId { get; set; }

    private LotFormModel _model = new();
    private List<Category> _categories = [];
    private List<Bidder> _bidders = [];
    private RenderFragment? _deleteButton;

    protected override async Task OnParametersSetAsync()
    {
        _categories = await CategoryService.GetCategoriesAsync();
        _bidders = await LotService.GetBiddersAsync();

        if (LotId.HasValue)
        {
            var lot = await LotService.GetLotAsync(LotId.Value);
            if (lot is null)
            {
                Flash.SetError("notfound");
                Navigation.NavigateTo("/lots/lots");
                return;
            }

            _model = new LotFormModel
            {
                LotID = lot.LotID,
                Description = lot.Description,
                CategoryID = lot.CategoryID,
                HighestBid = lot.WinningBid,
                BidderID = lot.WinningBidder,
                Delivered = lot.Delivered,
                Image = lot.Image
            };

            _deleteButton = builder =>
            {
                builder.OpenElement(0, "a");
                builder.AddAttribute(1, "href", $"/lots/lots/delete/{LotId.Value}");
                builder.AddAttribute(2, "class", "c-btn c-btn--danger");
                builder.AddContent(3, "Delete Lot");
                builder.CloseElement();
            };
        }
        else
        {
            _model = new LotFormModel();
            _deleteButton = null;
        }
    }

    private async Task HandleSubmit()
    {
        bool ok;
        if (LotId.HasValue)
        {
            ok = await LotService.UpdateLotAsync(LotId.Value, _model);
        }
        else
        {
            ok = await LotService.AddLotAsync(_model);
        }

        if (ok)
        {
            Navigation.NavigateTo("/lots/lots");
        }
    }
}
