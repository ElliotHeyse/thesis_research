@page "/donors/edit"
@page "/donors/edit/{DonorId:int}"
@rendermode InteractiveServer
@inject DonorService DonorService
@inject NavigationManager Navigation
@inject FlashMessageService Flash

<PageTitle>@(DonorId.HasValue ? "Edit Donor" : "Add Donor") | Taylor PTA - Silent Auction</PageTitle>

<DonorsSubNav />
<FlashAlert />

<EditForm Model="_model" OnValidSubmit="HandleSubmit" class="c-form">
    <DataAnnotationsValidator />

    <div class="c-form__field">
        <label for="BusinessName">Business Name</label>
        <InputText id="BusinessName" @bind-Value="_model.BusinessName" maxlength="75" class="c-form__input" />
        <ValidationMessage For="@(() => _model.BusinessName)" />
    </div>

    <div class="c-form__field">
        <label for="ContactName">Contact Name</label>
        <InputText id="ContactName" @bind-Value="_model.ContactName" maxlength="75" class="c-form__input" required />
        <ValidationMessage For="@(() => _model.ContactName)" />
    </div>

    <div class="c-form__field">
        <label for="ContactEmail">Email</label>
        <InputText id="ContactEmail" @bind-Value="_model.ContactEmail" maxlength="200" class="c-form__input" />
        <ValidationMessage For="@(() => _model.ContactEmail)" />
    </div>

    <div class="c-form__field">
        <label for="ContactTitle">Contact Title</label>
        <InputText id="ContactTitle" @bind-Value="_model.ContactTitle" maxlength="75" class="c-form__input" />
        <ValidationMessage For="@(() => _model.ContactTitle)" />
    </div>

    <div class="c-form__field">
        <label for="Address">Address</label>
        <InputText id="Address" @bind-Value="_model.Address" maxlength="75" class="c-form__input" />
        <ValidationMessage For="@(() => _model.Address)" />
    </div>

    <div class="c-form__field">
        <label for="City">City</label>
        <InputText id="City" @bind-Value="_model.City" maxlength="30" class="c-form__input" />
        <ValidationMessage For="@(() => _model.City)" />
    </div>

    <div class="c-form__field">
        <label for="State">State</label>
        <InputText id="State" @bind-Value="_model.State" maxlength="2" class="c-form__input" />
        <ValidationMessage For="@(() => _model.State)" />
    </div>

    <div class="c-form__field">
        <label for="ZipCode">Zip Code</label>
        <InputText id="ZipCode" @bind-Value="_model.ZipCode" maxlength="5" class="c-form__input" />
        <ValidationMessage For="@(() => _model.ZipCode)" />
    </div>

    @if (DonorId.HasValue)
    {
        <div class="c-form__field">
            <label>
                <InputCheckbox @bind-Value="_model.TaxReceipt" />
                Tax Receipt Sent
            </label>
        </div>
    }

    <div class="form-actions">
        <button type="submit" class="c-btn c-btn--primary">@(DonorId.HasValue ? "Update Donor" : "Add Donor")</button>
        <a href="/donors" class="c-btn c-btn--secondary">Cancel</a>
    </div>
</EditForm>

@code {
    [Parameter] public int? DonorId { get; set; }

    private DonorFormModel _model = new();

    protected override async Task OnParametersSetAsync()
    {
        if (DonorId.HasValue)
        {
            var donor = await DonorService.GetDonorAsync(DonorId.Value);
            if (donor is null)
            {
                Flash.SetError("notfound");
                Navigation.NavigateTo("/donors");
                return;
            }

            _model = new DonorFormModel
            {
                DonorID = donor.DonorID,
                BusinessName = donor.BusinessName,
                ContactName = donor.ContactName,
                ContactEmail = donor.ContactEmail,
                ContactTitle = donor.ContactTitle,
                Address = donor.Address,
                City = donor.City,
                State = donor.State,
                ZipCode = donor.ZipCode,
                TaxReceipt = donor.TaxReceipt
            };
        }
        else
        {
            _model = new DonorFormModel();
        }
    }

    private async Task HandleSubmit()
    {
        bool ok;
        string successKey;
        string errorKey;

        if (DonorId.HasValue)
        {
            ok = await DonorService.UpdateDonorAsync(DonorId.Value, _model);
            successKey = "updated";
            errorKey = "update_failed";
        }
        else
        {
            ok = await DonorService.AddDonorAsync(_model);
            successKey = "created";
            errorKey = "create_failed";
        }

        if (ok)
        {
            Flash.SetSuccess(successKey);
        }
        else
        {
            Flash.SetError(errorKey);
        }

        Navigation.NavigateTo("/donors");
    }
}
