@page "/donors/delete/{DonorId:int}"
@page "/donors/delete/{DonorId:int}/confirm"
@rendermode InteractiveServer
@inject DonorService DonorService
@inject NavigationManager Navigation
@inject FlashMessageService Flash

<PageTitle>Delete Donor | Taylor PTA - Silent Auction</PageTitle>

<DonorsSubNav />

@if (_donor is null)
{
    <p>Loading...</p>
}
else if (_confirmed)
{
    <p>Deleting...</p>
}
else
{
    <ConfirmDelete EntityType="donor"
                   ConfirmUrl="@($"/donors/delete/{DonorId}/confirm")"
                   CancelUrl="/donors">
        <Fields>
            <p><strong>Donor ID:</strong> @_donor.DonorID</p>
            <p><strong>Business Name:</strong> @FormatHelper.OrDash(_donor.BusinessName)</p>
            <p><strong>Contact Name:</strong> @FormatHelper.OrDash(_donor.ContactName)</p>
            <p><strong>Email:</strong> @FormatHelper.OrDash(_donor.ContactEmail)</p>
            <p><strong>City:</strong> @FormatHelper.OrDash(_donor.City)</p>
        </Fields>
    </ConfirmDelete>
}

@code {
    [Parameter] public int DonorId { get; set; }

    private Donor? _donor;
    private bool _confirmed;

    protected override async Task OnParametersSetAsync()
    {
        _donor = await DonorService.GetDonorAsync(DonorId);
        if (_donor is null)
        {
            Flash.SetError("notfound");
            Navigation.NavigateTo("/donors");
            return;
        }

        if (Navigation.Uri.Contains("/confirm", StringComparison.OrdinalIgnoreCase))
        {
            _confirmed = true;
            var ok = await DonorService.DeleteDonorAsync(DonorId);
            if (ok)
            {
                Flash.SetSuccess("deleted");
            }
            else
            {
                Flash.SetError("has_items");
            }

            Navigation.NavigateTo("/donors");
        }
    }
}
