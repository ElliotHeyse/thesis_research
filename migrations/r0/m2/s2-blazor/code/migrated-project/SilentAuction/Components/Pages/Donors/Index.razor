@page "/donors"
@rendermode InteractiveServer
@inject DonorService DonorService

<PageTitle>Donors | Taylor PTA - Silent Auction</PageTitle>

<DonorsSubNav ActionContent="@_addButton" />
<FlashAlert />

@if (_loadFailed)
{
    <div class="empty-state danger">Connection failed</div>
}
else
{
<DataTable ItemCount="_donors?.Count">
    <Header>
        <tr>
            <th>ID</th>
            <th>Business Name</th>
            <th>Contact Name</th>
            <th>Email</th>
            <th>City</th>
            <th>State</th>
            <th>Tax Receipt</th>
            <th>Actions</th>
        </tr>
    </Header>
    <Body>
        @if (_donors is not null)
        {
            @foreach (var donor in _donors)
            {
                <tr>
                    <td>@donor.DonorID</td>
                    <td>@FormatHelper.OrDash(donor.BusinessName)</td>
                    <td>@FormatHelper.OrDash(donor.ContactName)</td>
                    <td>@FormatHelper.OrDash(donor.ContactEmail)</td>
                    <td>@FormatHelper.OrDash(donor.City)</td>
                    <td>@FormatHelper.OrDash(donor.State)</td>
                    <td>@FormatHelper.YesNo(donor.TaxReceipt)</td>
                    <td>
                        <a href="/donors/edit/@donor.DonorID">Edit</a>
                        |
                        <a href="/donors/delete/@donor.DonorID">Delete</a>
                    </td>
                </tr>
            }
        }
    </Body>
</DataTable>
}

@code {
    private List<Donor>? _donors;
    private RenderFragment _addButton = builder =>
    {
        builder.OpenElement(0, "a");
        builder.AddAttribute(1, "href", "/donors/edit");
        builder.AddAttribute(2, "class", "c-btn c-btn--primary");
        builder.AddContent(3, "Add New Donor");
        builder.CloseElement();
    };

    protected override async Task OnInitializedAsync()
    {
        _donors = await PageDataLoader.LoadAsync(DonorService.GetDonorsAsync);
        _loadFailed = _donors is null;
    }

    private bool _loadFailed;
}
