@page "/lots/items"
@rendermode InteractiveServer
@inject ItemService ItemService
@inject NavigationManager Navigation
@inject FlashMessageService Flash

<PageTitle>Items | Taylor PTA - Silent Auction</PageTitle>

<LotsSubNav ActionContent="@_subnavActions" />
<FlashAlert />

@if (_items is null || _lots is null)
{
    <p>Loading...</p>
}
else if (_items.Count == 0)
{
    <div class="empty-state info">No items found</div>
}
else
{
    <EditForm Model="_formModel" OnValidSubmit="SaveLotChanges" FormName="items-lot-form" id="items-lot-form">
        <table class="template-table">
            <thead>
                <tr>
                    <th>Item ID</th>
                    <th>Description</th>
                    <th>Retail Value</th>
                    <th>Donor</th>
                    <th>Lot</th>
                    <th>Actions</th>
                    <th>Download Bidding Sheet</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in _items)
                {
                    <tr>
                        <td>@item.ItemID</td>
                        <td>@FormatHelper.OrDash(item.Description)</td>
                        <td>@FormatHelper.OrDash(item.RetailValue.ToString())</td>
                        <td>@FormatHelper.OrDash(item.BusinessName)</td>
                        <td>
                            <select name="LotID[@item.ItemID]" @bind="_lotSelections[item.ItemID]" class="c-form__input">
                                <option value="-1">--- No lot selected ---</option>
                                @foreach (var lot in _lots)
                                {
                                    <option value="@lot.LotID">@lot.Description</option>
                                }
                            </select>
                        </td>
                        <td>
                            <a href="/lots/items/edit/@item.ItemID">Edit</a>
                            |
                            <a href="/lots/items/delete/@item.ItemID">Delete</a>
                        </td>
                        <td>
                            <a href="/api/pdf/bidding-sheet/@item.ItemID" class="c-btn c-btn--success" target="_blank">Download Bidding Sheet</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </EditForm>
}

@code {
    private List<ItemListRow>? _items;
    private List<Lot>? _lots;
    private Dictionary<int, int> _lotSelections = new();
    private object _formModel = new();

    private RenderFragment _subnavActions => builder =>
    {
        builder.OpenElement(0, "a");
        builder.AddAttribute(1, "href", "/lots/items/edit");
        builder.AddAttribute(2, "class", "c-btn c-btn--primary");
        builder.AddContent(3, "Add New Item");
        builder.CloseElement();
        builder.OpenElement(4, "button");
        builder.AddAttribute(5, "type", "submit");
        builder.AddAttribute(6, "form", "items-lot-form");
        builder.AddAttribute(7, "class", "c-btn c-btn--success");
        builder.AddContent(8, "Save Changes");
        builder.CloseElement();
    };

    protected override async Task OnInitializedAsync()
    {
        _items = await ItemService.GetItemsAsync();
        _lots = await ItemService.GetLotDescriptionsAsync();

        if (_items is not null)
        {
            foreach (var item in _items)
            {
                _lotSelections[item.ItemID] = item.LotID ?? -1;
            }
        }
    }

    private async Task SaveLotChanges()
    {
        if (_items is null)
        {
            return;
        }

        var changes = new List<LotAssignmentChange>();
        foreach (var item in _items)
        {
            var currentNormalized = item.LotID ?? -1;
            var newNormalized = _lotSelections.GetValueOrDefault(item.ItemID, -1);
            if (currentNormalized != newNormalized)
            {
                changes.Add(new LotAssignmentChange { ItemID = item.ItemID, NewLotID = newNormalized });
            }
        }

        if (changes.Count > 0)
        {
            var ok = await ItemService.ModifyItemsAsync(changes);
            if (!ok)
            {
                Flash.SetError("update_failed");
                Navigation.NavigateTo("/lots/items");
                return;
            }
        }

        Flash.SetSuccess("updated");
        Navigation.NavigateTo("/lots/items");
    }
}
