@page "/lots/categories/edit"
@page "/lots/categories/edit/{CategoryId:int}"
@rendermode InteractiveServer
@inject CategoryService CategoryService
@inject NavigationManager Navigation
@inject FlashMessageService Flash

<PageTitle>@(CategoryId.HasValue ? "Edit Category" : "Add Category") | Taylor PTA - Silent Auction</PageTitle>

<LotsSubNav ActionContent="@_deleteButton" />
<FlashAlert />

<EditForm Model="_model" OnValidSubmit="HandleSubmit" class="c-form">
    <DataAnnotationsValidator />

    <div class="c-form__field">
        <label for="Description">Description</label>
        <InputText id="Description" @bind-Value="_model.Description" class="c-form__input" />
        <ValidationMessage For="@(() => _model.Description)" />
    </div>

    <div class="form-actions">
        <button type="submit" class="c-btn c-btn--primary">@(CategoryId.HasValue ? "Update" : "Add Category")</button>
        <a href="/lots/categories" class="c-btn c-btn--secondary">Cancel</a>
    </div>
</EditForm>

@code {
    [Parameter] public int? CategoryId { get; set; }

    private CategoryFormModel _model = new();
    private RenderFragment? _deleteButton;

    protected override async Task OnParametersSetAsync()
    {
        if (CategoryId.HasValue)
        {
            var category = await CategoryService.GetCategoryAsync(CategoryId.Value);
            if (category is null)
            {
                Flash.SetError("notfound");
                Navigation.NavigateTo("/lots/categories");
                return;
            }

            _model = new CategoryFormModel
            {
                CategoryID = category.CategoryID,
                Description = category.Description
            };

            _deleteButton = builder =>
            {
                builder.OpenElement(0, "a");
                builder.AddAttribute(1, "href", $"/lots/categories/delete/{CategoryId.Value}");
                builder.AddAttribute(2, "class", "c-btn c-btn--danger");
                builder.AddContent(3, "Delete Category");
                builder.CloseElement();
            };
        }
        else
        {
            _model = new CategoryFormModel();
            _deleteButton = null;
        }
    }

    private async Task HandleSubmit()
    {
        if (CategoryId.HasValue)
        {
            await CategoryService.UpdateCategoryAsync(CategoryId.Value, _model);
        }
        else
        {
            await CategoryService.AddCategoryAsync(_model);
        }

        Navigation.NavigateTo("/lots/categories");
    }
}
