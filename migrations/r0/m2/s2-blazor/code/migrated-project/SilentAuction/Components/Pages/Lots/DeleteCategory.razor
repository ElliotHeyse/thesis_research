@page "/lots/categories/delete/{CategoryId:int}"
@page "/lots/categories/delete/{CategoryId:int}/confirm"
@rendermode InteractiveServer
@inject CategoryService CategoryService
@inject NavigationManager Navigation
@inject FlashMessageService Flash

<PageTitle>Delete Category | Taylor PTA - Silent Auction</PageTitle>

<LotsSubNav />

@if (_category is null)
{
    <p>Loading...</p>
}
else if (!_confirmed)
{
    <ConfirmDelete EntityType="category"
                   ConfirmUrl="@($"/lots/categories/delete/{CategoryId}/confirm")"
                   CancelUrl="/lots/categories">
        <Fields>
            <p><strong>Category ID:</strong> @_category.CategoryID</p>
            <p><strong>Description:</strong> @FormatHelper.OrDash(_category.Description)</p>
        </Fields>
    </ConfirmDelete>
}

@code {
    [Parameter] public int CategoryId { get; set; }

    private Category? _category;
    private bool _confirmed;

    protected override async Task OnParametersSetAsync()
    {
        _category = await CategoryService.GetCategoryAsync(CategoryId);
        if (_category is null)
        {
            Flash.SetError("notfound");
            Navigation.NavigateTo("/lots/categories");
            return;
        }

        if (Navigation.Uri.Contains("/confirm", StringComparison.OrdinalIgnoreCase))
        {
            _confirmed = true;
            await CategoryService.DeleteCategoryAsync(CategoryId);
            Flash.SetSuccess("deleted");
            Navigation.NavigateTo("/lots/categories");
        }
    }
}
